export function renderIntroSection() { return <IntroSection />; }
export function renderFertilitySection() { return <FertilitySection />; }
export function renderFibromyalgiaSection() { return <FibromyalgiaSection />; }
export function renderLowerBackPainSection() { return <LowerBackPainSection />; }
export function renderStopSmokingSection() { return <StopSmokingSection />; }
export function renderWeightLossSection() { return <WeightLossSection />; }

export function renderBrochureSection(id: BrochureSectionId) {
  switch (id) {
    case 'intro':
      return renderIntroSection();
    case 'fertility':
      return renderFertilitySection();
    case 'fibromyalgia':
      return renderFibromyalgiaSection();
    case 'lower-back-pain':
      return renderLowerBackPainSection();
    case 'stop-smoking':
      return renderStopSmokingSection();
    case 'weight-loss':
      return renderWeightLossSection();
    default:
      return null;
  }
} 