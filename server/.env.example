# Copy to .env and fill in. Do not commit .env.

PORT=3001

# Allowed origin for CORS (frontend URL). Use your Vite dev URL or production site.
CORS_ORIGIN=http://localhost:5173

# Admin credentials. Generate password hash with: node scripts/hash-password.js "YourPassword"
ADMIN_USER_ID=admin
ADMIN_PASSWORD_HASH=

# Secret for signing JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cookie: set to true in production (HTTPS)
COOKIE_SECURE=false
